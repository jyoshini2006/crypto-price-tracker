# Copy to .env and fill in only what you need. .env is git-ignored.
# Values are pulled in by config.py via ${VAR} placeholders in config.yaml.

# --- Alert delivery -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- Optional paid fallback provider --------------------------------------
# CoinGecko needs no key. A CoinMarketCap Pro key adds a second fallback.
CMC_API_KEY=
